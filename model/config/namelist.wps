&share
 wrf_core = 'ARW',
 max_dom = 3,
 start_date = '2026-10-15_00:00:00','2026-10-15_00:00:00','2026-10-15_00:00:00',
 end_date   = '2026-10-18_00:00:00','2026-10-18_00:00:00','2026-10-18_00:00:00',
 interval_seconds = 21600,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         =   1,   1,   2,
 parent_grid_ratio =   1,   3,   3,
 i_parent_start    =   1,  32,  41,
 j_parent_start    =   1,  28,  39,
 e_we              = 100, 121, 121,
 e_sn              =  90, 121, 121,
 geog_data_res     = 'default','default','default',
 dx = 27000,
 dy = 27000,
 map_proj = 'lambert',
 ref_lat   = 28.6139,
 ref_lon   = 77.2090,
 truelat1  = 28.0,
 truelat2  = 30.0,
 stand_lon = 77.0,
 geog_data_path = '/opt/wrf/data/WPS_GEOG/'
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE',
 io_form_metgrid = 2,
/
